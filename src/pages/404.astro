---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 — Page not found | AniMatch">
  <main class="flex flex-1 flex-col items-center justify-center px-4 py-24 text-center">
    <p class="font-display text-gradient text-8xl font-bold">404</p>
    <h1 class="font-display mt-4 text-2xl font-semibold text-white">This page went on a journey</h1>
    <p class="mt-2 max-w-sm text-white/50">It doesn't exist or has moved. Your next favorite anime is back home.</p>
    <a
      href="/"
      class="bg-accent-gradient mt-8 rounded-xl px-6 py-3 font-semibold text-white shadow-lg shadow-fuchsia-900/30 transition hover:brightness-110"
    >
      Back to AniMatch
    </a>
  </main>
</Layout>
